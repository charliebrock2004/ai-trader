# AI-Trader — placeholder values only.
# Copy to .env on your machine. NEVER commit a real .env file.
# NEVER put live-trading credentials anywhere in this repository.
#
# Live trading is disabled in code. It cannot be turned on with an env var.

# -----------------------------------------------------------------------------
# Control
# Required to call any mutating endpoint. With this unset, read-only pages work
# and every mutation is REFUSED — an unconfigured deployment is closed, not open.
# Use something long and random (`openssl rand -hex 32`). It is read on the
# server only and never reaches the browser.
#
# Set the SAME value on the worker and on the frontend. They are the two ends of
# one connection; if they differ the worker answers 401.
# -----------------------------------------------------------------------------
AI_TRADER_API_TOKEN=

# -----------------------------------------------------------------------------
# The persistent worker
#
# Set on the FRONTEND only, pointing at the deployed worker. When it is set the
# frontend proxies every engine command over HTTPS and attaches the token above
# server-side. When it is empty, `npm run dev` spawns a local Python worker over
# stdio instead — same engine, same commands, different transport.
#
# Never prefix this VITE_: that would inline it into the browser bundle.
# -----------------------------------------------------------------------------
PAPER_WORKER_URL=

# Optional second gate, on the FRONTEND's own mutating routes. With this set,
# callers must present it as an x-ai-trader-token header — useful for driving
# the API from a script. With it unset, whoever can load the page can press
# Start, so restrict page access at the platform (Vercel Deployment Protection).
AI_TRADER_UI_TOKEN=

# Port for `python -m ai_trader http`. Managed hosts inject PORT and that wins;
# this is the local override.
WORKER_HOST=0.0.0.0
WORKER_PORT=8090

# -----------------------------------------------------------------------------
# Agent economics
# -----------------------------------------------------------------------------
STARTING_EQUITY=100.00
BASE_CURRENCY=GBP
# Fraction of starting equity at which the agent is PERMANENTLY shut down.
# Reaching this is irreversible; the agent cannot clear it.
TERMINAL_THRESHOLD_PCT=0.40
# Known daily running cost, used only for the runway estimate. It never
# influences sizing or the edge threshold.
HOSTING_COST_PER_DAY=0.0

# -----------------------------------------------------------------------------
# Trading mode
# Allowed: simulate | paper. Any other value (including "live") refuses to start.
# -----------------------------------------------------------------------------
TRADING_MODE=simulate

# -----------------------------------------------------------------------------
# Grok / xAI — the analyst
# The model reviews trades that Python has already priced and sized. It cannot
# choose a ticker, a size, a price or a venue. Off by default; with no key the
# agent simply has nothing challenging its deterministic edge, which the System
# page reports as degraded.
# -----------------------------------------------------------------------------
GROK_PAPER_ANALYSIS=false
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1
XAI_TIMEOUT=20

# -----------------------------------------------------------------------------
# Official data
# Optional free BLS registration key. It lifts the anonymous request quota;
# without it the adapter still works at a lower rate limit.
# -----------------------------------------------------------------------------
BLS_API_KEY=

# -----------------------------------------------------------------------------
# Alpaca paper — dormant
# Not the fill path. The adapter is observation only and the session path traps
# submit on every broker. The live host is blocked at startup.
# -----------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# Storage
# This directory holds the audit trail, the kill switch AND the terminal latch.
# Put it on a persistent volume: an ephemeral one would erase the decision
# history and resurrect a TERMINATED agent.
#
# On Render, mount a disk at /var/data and set DATABASE_PATH=/var/data/ai_trader.db.
# -----------------------------------------------------------------------------
DATABASE_PATH=data/ai_trader.db
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------------
# Operator halt. Separate from the terminal latch, and reversible.
# -----------------------------------------------------------------------------
KILL_SWITCH_ENGAGED=true

DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
