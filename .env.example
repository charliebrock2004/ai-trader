# AI-Trader — placeholder credentials only.
# Copy to .env on your machine. NEVER commit a real .env file.
# NEVER put live-trading credentials here.
#
# Live trading is disabled in code. It cannot be turned on with env vars.

# -----------------------------------------------------------------------------
# Trading mode
# Allowed values: simulate | paper
# Any other value (including "live") will refuse to start.
# -----------------------------------------------------------------------------
TRADING_MODE=simulate

# -----------------------------------------------------------------------------
# Grok / xAI  (analysis layer — not wired in the foundation build)
# Leave blank until you are ready. The app never reads this in the browser.
# -----------------------------------------------------------------------------
XAI_API_KEY=
XAI_MODEL=grok-4.5
XAI_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Alpaca paper trading (execution — not connected in the foundation build)
# Use PAPER keys only. The live Alpaca URL is rejected at startup.
# -----------------------------------------------------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# -----------------------------------------------------------------------------
# Storage / logging
# -----------------------------------------------------------------------------
DATABASE_PATH=data/ai_trader.db
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------------
# Safety
# Kill switch starts ENGAGED. While engaged, the pipeline will not run.
# -----------------------------------------------------------------------------
KILL_SWITCH_ENGAGED=true

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
